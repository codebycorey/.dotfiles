#!/usr/bin/env zsh

# --- Core ---

alias vim="nvim"
alias cp="cp -iv"
alias mv="mv -iv"
alias mkdir="mkdir -pv"
alias ls='ls -G'
alias ll="ls -FGlAhp"
cd() { builtin cd "$@" && ll; }
alias ..="cd ../"
alias ...="cd ../../"
alias ....="cd ../../../"
alias proj="cd ~/projects/personal"
alias dots="cd ~/.dotfiles"
alias c="clear"
alias path="echo -e ${PATH}"
alias grep='grep --color=auto'

mcd () { mkdir -p "$1" && cd "$1"; }

# --- Networking ---

alias myip="curl ifconfig.me"
alias flushDNS="dscacheutil -flushcache"

# --- macOS ---

alias cleanupDS="find . -type f -name '*.DS_Store' -ls -delete"
alias finderShowHidden="defaults write com.apple.finder ShowAllFiles TRUE"
alias finderHideHidden="defaults write com.apple.finder ShowAllFiles FALSE"

# --- Claude Code ---

alias cc="claude"
alias ccp="claude --print"
alias ccr="claude --resume"
alias ccc="claude --continue"
alias ccd="claude --dangerously-skip-permissions"

# --- Notify ---
alias nrun="notify-run"

# --- Functions ---

np() {
    local project_dir="$HOME/projects/personal/$1"
    if [[ -z "$1" ]]; then
        echo "Usage: np <project-name>"
        return 1
    fi
    if [[ -d "$project_dir" ]]; then
        echo "Project '$1' already exists at $project_dir"
        return 1
    fi
    mkdir -p "$project_dir"
    git -C "$project_dir" init
    echo "Created $project_dir"
    echo "Next: Ctrl-f or prefix f to switch to it"
}

extract () {
    if [ -f "${1}" ] ; then
        case "${1}" in
            *.tar.bz2)   tar xjf "${1}"     ;;
            *.tar.gz)    tar xzf "${1}"     ;;
            *.bz2)       bunzip2 "${1}"     ;;
            *.rar)       unrar e "${1}"     ;;
            *.gz)        gunzip "${1}"      ;;
            *.tar)       tar xf "${1}"      ;;
            *.tbz2)      tar xjf "${1}"     ;;
            *.tgz)       tar xzf "${1}"     ;;
            *.zip)       unzip "${1}"       ;;
            *.Z)         uncompress "${1}"  ;;
            *.7z)        7z x "${1}"        ;;
            *)     echo "'${1}' cannot be extracted via extract()" ;;
        esac
    else
        echo "'${1}' is not a valid file"
    fi
}
