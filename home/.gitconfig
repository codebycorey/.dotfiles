[init]
    defaultBranch = main

[push]
    default = current
    autoSetupRemote = true

[pull]
    rebase = true

[fetch]
    prune = true

[rerere]
    enabled = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[core]
    editor = nvim

[branch]
    sort = -committerdate

[include]
    path = ~/.gitconfig.local
