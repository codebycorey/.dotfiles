#!/usr/bin/env bash
# Capture terminal output from the calling pane and analyze with Claude Code

if ! command -v claude &> /dev/null; then
    echo "Error: claude command not found. Install Claude Code first."
    echo ""
    echo "Press Enter to close..."
    read -r
    exit 1
fi

target_pane="${1:?Usage: tmux-capture-context <pane_id>}"

captured=$(tmux capture-pane -t "$target_pane" -p -S -200)

if [[ -z "$captured" ]]; then
    echo "No content captured from pane."
    echo ""
    echo "Press Enter to close..."
    read -r
    exit 1
fi

tmpfile=$(mktemp "${TMPDIR:-/tmp}/tmux-context.XXXXXX")
trap 'rm -f "$tmpfile"' EXIT

cat > "$tmpfile" << EOF
Analyze this terminal output. Identify any errors, warnings, or issues. Suggest fixes if applicable.

---
$captured
---
EOF

claude --print < "$tmpfile"

echo ""
echo "Press Enter to close..."
read -r
