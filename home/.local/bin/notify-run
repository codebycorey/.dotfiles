#!/usr/bin/env bash
# Run a command and send macOS notification on completion

if [[ $# -eq 0 ]]; then
    echo "Usage: notify-run <command> [args...]"
    exit 1
fi

start_time=$SECONDS

"$@"
exit_code=$?

duration=$(( SECONDS - start_time ))
command_name="$1"

if [[ $exit_code -eq 0 ]]; then
    title="Command Succeeded"
    status="succeeded"
else
    title="Command Failed"
    status="failed (exit $exit_code)"
fi

# Sanitize command_name for AppleScript
sanitized_command="${command_name//\\/\\\\}"
sanitized_command="${sanitized_command//\"/\\\"}"

osascript -e "display notification \"$sanitized_command $status in ${duration}s\" with title \"$title\""

exit $exit_code
